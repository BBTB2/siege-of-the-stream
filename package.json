{
  "name": "siege-of-the-stream",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests public package.json tsconfig.json vitest.config.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^4.1.12",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  }
}
